# Staging-only template. Never copy production secrets into the review checkout.
NEXT_PUBLIC_SUPABASE_URL=https://staging-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_staging_server_secret
OPENAI_API_KEY=replace_with_staging_api_key
OPENAI_MODEL=gpt-5-mini
# Reduce reasoning/output-limit recovery; explicit overrides remain supported.
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_TRANSIENT_RETRIES=1
OPENAI_REQUEST_TIMEOUT_MS=90000
PARALLEL_ROASTERS=4
CRAWLER_PAGE_CONCURRENCY=1
